DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
APP_ENV=development
# se definires API_KEY, todos os endpoints (exceto /health e /docs) exigem header: X-API-Key
# seixa vazio em desenvolvimento local para testar sem chave
API_KEY=
PORT=8000
ALLOWED_ORIGINS=*
TIMEZONE=Europe/Lisbon
# pedidos por IP: 60/min (normal), 120/min (app com muitos pedidos), 30/min (mais restritivo)
RATE_LIMIT=60/minute